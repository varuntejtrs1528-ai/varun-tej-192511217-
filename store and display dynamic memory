#include<stdio.h>
#include<stdlib.h>
struct s { int x; };

void display(struct s *p,int n){
    int i;
    for(i=0;i<n;i++)
        printf("%d ",p[i].x);
}

void main(){
    int n=3,i;
    struct s *p = (struct s*)malloc(n*sizeof(struct s));

    for(i=0;i<n;i++)
        p[i].x=i+1;

    display(p,n);
}
