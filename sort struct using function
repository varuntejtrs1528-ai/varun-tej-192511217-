#include<stdio.h>
struct s { int m; };

void sort(struct s a[], int n){
    int i,j;
    struct s t;
    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(a[i].m>a[j].m){
                t=a[i]; a[i]=a[j]; a[j]=t;
            }
}

void main(){
    struct s a[3]={{30},{10},{20}};
    int i;
    sort(a,3);
    for(i=0;i<3;i++) printf("%d ",a[i].m);
}
