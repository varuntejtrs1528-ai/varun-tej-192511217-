#include<stdio.h>
struct s{ int m; };

void main(){
    struct s a[3]={{10},{20},{30}};
    int ch,i,sum=0;

    printf("1.Sum 2.Display\n");
    scanf("%d",&ch);

    switch(ch){
        case 1:
            for(i=0;i<3;i++) sum+=a[i].m;
            printf("%d",sum);
            break;
        case 2:
            for(i=0;i<3;i++) printf("%d ",a[i].m);
            break;
    }
}
