#include<stdio.h>
struct s{ int m; };

int second(struct s a[],int n){
    int i,max=0,sec=0;
    for(i=0;i<n;i++){
        if(a[i].m>max){
            sec=max;
            max=a[i].m;
        }
        else if(a[i].m>sec && a[i].m!=max)
            sec=a[i].m;
    }
    return sec;
}

void main(){
    struct s a[3]={{10},{30},{20}};
    printf("%d",second(a,3));
}
