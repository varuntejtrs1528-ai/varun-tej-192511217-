#include<stdio.h>

void reverse(char *str)
{
    int i, len = 0;
    char temp;

    while(str[len] != '\0')
        len++;

    for(i = 0; i < len/2; i++)
    {
        temp = str[i];
        str[i] = str[len-i-1];
        str[len-i-1] = temp;
    }
}

void main()
{
    char str[] = "hello";
    reverse(str);
    printf("%s", str);
}
