#include <stdio.h>
struct student { int id; };

int main() {
    struct student s[2]={{2},{1}};
    for(int i=0;i<2;i++){
        for(int j=i+1;j<2;j++){
            if(s[i].id > s[j].id){
                struct student temp=s[i];
                s[i]=s[j];
                s[j]=temp;
            }
        }
    }
}
